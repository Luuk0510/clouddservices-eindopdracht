# Service runtime
PORT=3002
NODE_ENV=development

# Database
MONGODB_URI=mongodb://mongodb:27017/photo-prestige

# JWT authentication
JWT_SECRET=change-this-in-real-deployments

# RabbitMQ event bus
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=photo-prestige
RABBITMQ_RECONNECT_DELAY_MS=5000
