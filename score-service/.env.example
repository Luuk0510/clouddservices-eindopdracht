# Service runtime
PORT=3005
NODE_ENV=development

# Database
MONGODB_URI=mongodb://score-mongodb:27017/score-service

# JWT authentication
JWT_SECRET=change-this-to-a-long-random-secret

# Service dependencies
REGISTER_SERVICE_URL=http://register-service:3003
TARGET_SERVICE_URL=http://target-service:3002

# RabbitMQ event bus
RABBITMQ_URL=amqp://photo_user:change-this-rabbitmq-password@rabbitmq:5672
RABBITMQ_EXCHANGE=photo-prestige
RABBITMQ_RECONNECT_DELAY_MS=5000

# External image scoring provider
IMAGGA_API_KEY=
IMAGGA_API_SECRET=
IMAGGA_API_BASE_URL=https://api.imagga.com/v2
