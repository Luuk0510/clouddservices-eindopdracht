# Service runtime
PORT=3001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://mongodb:27017/photo-prestige

# JWT authentication
JWT_SECRET=change-this-in-real-deployments
JWT_EXPIRES_IN=1d

# Optional one-off admin process: npm run seed:owner
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me
