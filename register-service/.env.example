# Service runtime
PORT=3003
NODE_ENV=development

# Database
MONGODB_URI=mongodb://register-mongodb:27017/register-service

# JWT authentication
JWT_SECRET=change-this-to-a-long-random-secret

# Service dependencies
TARGET_SERVICE_URL=http://target-service:3002

# RabbitMQ event bus
RABBITMQ_URL=amqp://photo_user:change-this-rabbitmq-password@rabbitmq:5672
RABBITMQ_EXCHANGE=photo-prestige
RABBITMQ_RECONNECT_DELAY_MS=5000
