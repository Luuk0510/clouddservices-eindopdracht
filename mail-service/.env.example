# Service runtime
PORT=3006

# RabbitMQ event bus
RABBITMQ_URL=amqp://photo_user:change-this-rabbitmq-password@rabbitmq:5672
RABBITMQ_EXCHANGE=photo-prestige
RABBITMQ_RECONNECT_DELAY_MS=5000

# JWT authentication
JWT_SECRET=change-this-to-a-long-random-secret

# External mail provider
SENDGRID_API_KEY=
MAIL_FROM=Photo Prestige <noreply@example.com>
