{
  "openapi": "3.0.3",
  "info": {
    "title": "Photo Prestige API Gateway",
    "version": "1.0.0",
    "description": "Gateway documentation for the Photo Prestige microservices."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local gateway"
    }
  ],
  "tags": [
    { "name": "Gateway" },
    { "name": "Auth" },
    { "name": "Targets" },
    { "name": "Register" },
    { "name": "Score" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "version": { "type": "string", "example": "v1" },
          "service": { "type": "string", "example": "api-gateway" }
        }
      },
      "AuthPayload": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 6 },
          "role": { "type": "string", "enum": ["participant", "target-owner"] }
        }
      },
      "TargetCreate": {
        "type": "object",
        "required": ["title", "imageUrl", "lat", "lng", "deadlineAt"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "imageUrl": { "type": "string", "format": "uri" },
          "city": { "type": "string" },
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "radiusMeters": { "type": "number", "example": 250 },
          "deadlineAt": { "type": "string", "format": "date-time" }
        }
      },
      "SubmissionCreate": {
        "type": "object",
        "required": ["imageUrl"],
        "properties": {
          "imageUrl": { "type": "string", "format": "uri" }
        }
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["Gateway"],
        "summary": "Gateway health check",
        "responses": {
          "200": {
            "description": "Gateway is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthPayload" }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered" },
          "400": { "description": "Validation error" },
          "409": { "description": "User exists" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthPayload" }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Current user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Current user" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/targets": {
      "get": {
        "tags": ["Targets"],
        "summary": "List targets",
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Targets list" }
        }
      },
      "post": {
        "tags": ["Targets"],
        "summary": "Create target",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TargetCreate" }
            }
          }
        },
        "responses": {
          "201": { "description": "Target created" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/v1/targets/{targetId}": {
      "get": {
        "tags": ["Targets"],
        "summary": "Get target by id",
        "parameters": [
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Target details" },
          "404": { "description": "Target not found" }
        }
      },
      "delete": {
        "tags": ["Targets"],
        "summary": "Delete target",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Target deleted" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/v1/targets/{targetId}/submissions": {
      "post": {
        "tags": ["Score"],
        "summary": "Create submission",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SubmissionCreate" }
            }
          }
        },
        "responses": {
          "201": { "description": "Submission created" },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/targets/{targetId}/score": {
      "get": {
        "tags": ["Score"],
        "summary": "Get my best score",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Best score" },
          "404": { "description": "No score found" }
        }
      }
    },
    "/api/v1/targets/{targetId}/scores": {
      "get": {
        "tags": ["Score"],
        "summary": "Get all scores for target",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "All scores" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/v1/targets/{targetId}/winner": {
      "get": {
        "tags": ["Score"],
        "summary": "Get winner for target",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Winner" },
          "404": { "description": "Winner not calculated yet" }
        }
      }
    },
    "/api/v1/targets/{targetId}/registrations": {
      "post": {
        "tags": ["Register"],
        "summary": "Create registration",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "201": { "description": "Registration created" },
          "409": { "description": "Registration closed or duplicate" }
        }
      }
    },
    "/api/v1/targets/{targetId}/participants": {
      "get": {
        "tags": ["Register"],
        "summary": "List participants for target",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Participants list" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/v1/me/registrations": {
      "get": {
        "tags": ["Register"],
        "summary": "List my registrations",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "My registrations" }
        }
      }
    },
    "/api/v1/targets/{targetId}/registrations/me": {
      "delete": {
        "tags": ["Register"],
        "summary": "Cancel my registration for target",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Registration cancelled" },
          "404": { "description": "Registration not found" }
        }
      }
    },
    "/api/v1/submissions/{submissionId}": {
      "delete": {
        "tags": ["Score"],
        "summary": "Delete submission",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "submissionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Submission deleted" },
          "403": { "description": "Forbidden" }
        }
      }
    }
  }
}
