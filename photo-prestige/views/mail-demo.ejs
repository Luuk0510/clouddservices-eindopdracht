<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <main class="page">
      <%- include('partials/nav', { activePage: 'mail' }) %>

      <section class="hero">
        <h1><%= title %></h1>
      </section>

      <section class="card">
        <div class="card-header">
          <h2>Health</h2>
          <button id="mail-health-button" type="button">Check mail health</button>
        </div>
        <pre id="mail-health-result">Nog niet getest.</pre>
      </section>
    </main>

    <script src="/javascripts/demo-utils.js"></script>
    <script>
      window.demoUtils.bindHealthCheck('mail-health-button', 'mail-health-result', '/api/v1/mail/health');
    </script>
  </body>
</html>
